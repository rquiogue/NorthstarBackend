NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/northstar?schema=public&connection_limit=10&pool_timeout=20
JWT_ACCESS_TOKEN_SECRET=replace-with-a-long-secure-access-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_SECRET=replace-with-a-long-secure-refresh-secret
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
